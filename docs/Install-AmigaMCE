; $VER: Install-AmigaMCE 1.4 (11.11.2026)
;
; Installer script for AmigaMCE: the program with its fonts and licences,
; and the languages chosen: the Workbench's own (none besides English on
; an English one), all twelve at once, or ticked one by one.
; English is built into the program. Each language is a catalog in
; AmigaMCE/Catalogs; AmigaMCE knows a catalog by the language written in
; it, so its drawer's name (francais, espanol) does not matter.
; Japanese is never ticked to begin with: Workbench 3.x has no Japanese
; locale. It is chosen in AmigaMCE (Settings > General > Language), whose
; own glyphs draw it. Greek needs nothing from the Workbench either (no
; Greek fonts or ReplaceTopaz): AmigaMCE draws it with its own glyphs too.
; It is ticked where the Workbench's language is Greek, by either name
; it goes by ("greek" or "ellinika").
;
; Then, not on AGS (which has them): the libraries from Aminet in Extras,
; offered where LIBS: has none or an older one. modplug.library (public
; domain), mpega.library and xfdmaster.library with its decrunchers (free
; to pass on, not for profit, each archive whole and unchanged).
;
; This file is Latin-1 (Français, Español, Português).

(set @app-name "AmigaMCE")
(welcome "Welcome to AmigaMCE, a media centre for the Amiga.\n\nThis installs AmigaMCE and the languages you choose. Settings on an earlier installation are kept.")

(set #where
  (askdir
    (prompt "Where should AmigaMCE go?\n\nA drawer called AmigaMCE is made there, or brought up to date if it is there already.")
    (help @askdir-help)
    (default @default-dest)
  )
)
(set #dest (tackon #where "AmigaMCE"))
(set @default-dest #dest)

; the Workbench's language (Japanese is never assumed: chosen, or all)
(set #def 0)
(set #wbname "")
(if (= @language "deutsch") ((set #def 1) (set #wbname "Deutsch")))
(if (= @language "français") ((set #def 2) (set #wbname "Français")))
(if (= @language "italiano") ((set #def 4) (set #wbname "Italiano")))
(if (= @language "español") ((set #def 8) (set #wbname "Español")))
(if (= @language "svenska") ((set #def 16) (set #wbname "Svenska")))
(if (= @language "suomi") ((set #def 32) (set #wbname "Suomi")))
(if (= @language "dansk") ((set #def 64) (set #wbname "Dansk")))
(if (= @language "norsk") ((set #def 128) (set #wbname "Norsk")))
(if (= @language "nederlands") ((set #def 256) (set #wbname "Nederlands")))
(if (= @language "português") ((set #def 512) (set #wbname "Português")))
(if (= @language "greek") ((set #def 2048) (set #wbname "Greek")))
(if (= @language "ellinika") ((set #def 2048) (set #wbname "Greek")))

; first which: the Workbench's (or English alone), all twelve, or chosen
; one by one (the boxes have no "all")
(set #how
  (askchoice
    (prompt "Which languages, besides English (always there)?\n\nWith more than one, Settings > General > Language chooses.")
    (help "Each language is a catalog of about 20K, in AmigaMCE/Catalogs. One left out now can be copied there later from this archive's AmigaMCE/Catalogs drawer.")
    (choices
      (if #def (cat "Your Workbench's: " #wbname) "None: English only")
      "All twelve"
      "Let me choose...")
    (default 0)
  )
)
(if (= #how 0) (set #langs #def))
(if (= #how 1) (set #langs 4095))
(if (= #how 2)
  (set #langs
    (askoptions
      (prompt "Which languages, besides English (always there)?\n\nYour Workbench's language is ticked. With more than one, Settings > General > Language chooses.")
      (help "Each language is a catalog of about 20K, in AmigaMCE/Catalogs. One left out now can be copied there later from this archive's AmigaMCE/Catalogs drawer.")
      (choices "Deutsch" "Français" "Italiano" "Español" "Svenska" "Suomi" "Dansk" "Norsk" "Nederlands" "Português" "Nihongo (Japanese)" "Ellinika (Greek)")
      (default #def)
    )
  )
)

(if (= (exists #dest) 0)
  (makedir #dest (prompt "Making the AmigaMCE drawer") (help @makedir-help))
)
(copyfiles
  (prompt "Copying AmigaMCE")
  (help @copyfiles-help)
  (source "AmigaMCE.info")
  (dest #where)
)
(complete 10)
(copyfiles
  (prompt "Copying AmigaMCE, its fonts and licences")
  (help @copyfiles-help)
  (source "AmigaMCE")
  (dest #dest)
  (pattern "~(Catalogs)")
  (infos)
)
(complete 80)

; one language's catalog: #drawer set first (procedures with arguments
; need a newer Installer than some Workbenches have)
(procedure P_LANG
  (set #to (tackon #dest (tackon "Catalogs" #drawer)))
  (if (= (exists #cats) 0) (makedir #cats))
  (if (= (exists #to) 0) (makedir #to))
  (copyfiles
    (prompt "Copying a language")
    (help @copyfiles-help)
    (source (tackon "AmigaMCE/Catalogs" #drawer))
    (dest #to)
    (all)
  )
)
(set #cats (tackon #dest "Catalogs"))
(if (IN #langs 0) ((set #drawer "deutsch") (P_LANG)))
(if (IN #langs 1) ((set #drawer "francais") (P_LANG)))
(if (IN #langs 2) ((set #drawer "italiano") (P_LANG)))
(if (IN #langs 3) ((set #drawer "espanol") (P_LANG)))
(if (IN #langs 4) ((set #drawer "svenska") (P_LANG)))
(if (IN #langs 5) ((set #drawer "suomi") (P_LANG)))
(if (IN #langs 6) ((set #drawer "dansk") (P_LANG)))
(if (IN #langs 7) ((set #drawer "norsk") (P_LANG)))
(if (IN #langs 8) ((set #drawer "nederlands") (P_LANG)))
(if (IN #langs 9) ((set #drawer "portugues") (P_LANG)))
(if (IN #langs 10) ((set #drawer "nihongo") (P_LANG)))
(if (IN #langs 11) ((set #drawer "greek") (P_LANG)))
(complete 90)

; ---- Libraries for more of the music, from Aminet (Extras) --------------
; Not on AGS: it has them. Each offered ticked where LIBS: has none or an
; older one; copylib never puts an older library over a newer one.
(procedure P_VER
  (set #v 0)
  (if (exists #file (noreq)) (set #v (getversion #file)))
)
(procedure P_STATE
  (set #st "installed, up to date")
  (if (> #ours #v) (set #st "an older one installed"))
  (if (= #v 0) (set #st "not installed"))
)
(if (= (exists "AGS:" (noreq)) 0)
  (
    (set #cpu (database "cpu"))
    (set #mpsrc "Extras/mpega_library/libs/mpega020.library")
    (if (= #cpu "68040") (set #mpsrc "Extras/mpega_library/libs/mpega040.library"))
    (if (= #cpu "68060") (set #mpsrc "Extras/mpega_library/libs/mpega040.library"))

    (set #file "Extras/modplug/usr/modplug.library") (P_VER) (set #ours #v)
    (set #file "LIBS:modplug.library") (P_VER) (P_STATE)
    (set #st0 #st) (set #need0 (> #ours #v))
    (set #file #mpsrc) (P_VER) (set #ours #v)
    (set #file "LIBS:mpega.library") (P_VER) (P_STATE)
    (set #st1 #st) (set #need1 (> #ours #v))
    (set #file "Extras/xfd_User/Libs/xfdmaster.library") (P_VER) (set #ours #v)
    (set #file "LIBS:xfdmaster.library") (P_VER) (P_STATE)
    (set #st2 #st) (set #need2 (> #ours #v))

    (set #def 0)
    (if #need0 (set #def (+ #def 1)))
    (if #need1 (set #def (+ #def 2)))
    (if #need2 (set #def (+ #def 4)))
    (set #libs 0)
    (if #def
      (set #libs
        (askoptions
          (prompt "AmigaMCE plays more with these libraries from Aminet. Which should be installed in LIBS:? Those missing, or older than these, are ticked.")
          (help "modplug.library (public domain) mixes XM, S3M, IT and multichannel MODs on a 68020 or better.\n\nmpega.library 2.4 (Stéphane Tavenard, giftware) decodes MP3 for radio, Plex and music files: its 68040 build on a 68040 or 68060, its 68020 build otherwise.\n\nxfdmaster.library 39.15 (Georg Hörmann, Dirk Stöcker) unpacks packed modules; its decrunchers go in LIBS:xfd, only those not there already.\n\nmpega and xfd are free to pass on but not for profit. Their archives are in this one's Extras drawer, whole and unchanged, with their own documents.")
          (choices (cat "modplug.library: XM, S3M, IT (" #st0 ")")
                   (cat "mpega.library: MP3 (" #st1 ")")
                   (cat "xfdmaster.library: packed modules (" #st2 ")"))
          (default #def)
        )
      )
    )
    (set #lic (tackon #dest "Licences"))
    (if (IN #libs 0)
      (
        (copylib (prompt "Copying modplug.library") (help @copylib-help)
                 (source "Extras/modplug/usr/modplug.library") (dest "LIBS:"))
        (copyfiles (prompt "Copying modplug.library's licence") (help @copyfiles-help)
                   (source "Extras/modplug/usr/COPYING") (dest #lic) (newname "modplug.library-COPYING.txt"))
      )
    )
    (if (IN #libs 1)
      (
        (copylib (prompt "Copying mpega.library") (help @copylib-help)
                 (source #mpsrc) (dest "LIBS:") (newname "mpega.library"))
        (copyfiles (prompt "Copying mpega.library's terms") (help @copyfiles-help)
                   (source "Extras/mpega_library/mpega_library.doc") (dest #lic))
      )
    )
    (if (IN #libs 2)
      (
        (copylib (prompt "Copying xfdmaster.library") (help @copylib-help)
                 (source "Extras/xfd_User/Libs/xfdmaster.library") (dest "LIBS:"))
        (if (= (exists "LIBS:xfd" (noreq)) 0) (makedir "LIBS:xfd"))
        (foreach "Extras/xfd_User/Libs/xfd" "~(.#?)"
          (if (= (exists (tackon "LIBS:xfd" @each-name) (noreq)) 0)
            (copyfiles (prompt "Copying a decruncher") (help @copyfiles-help)
                       (source (tackon "Extras/xfd_User/Libs/xfd" @each-name)) (dest "LIBS:xfd") (nogauge))
          )
        )
        (copyfiles (prompt "Copying xfd's terms") (help @copyfiles-help)
                   (source "Extras/xfd_User/README") (dest #lic) (newname "xfdmaster.library-README.txt"))
      )
    )
  )
)
(complete 100)

; EaglePlayer's players play hundreds of module formats; AGS has them, and
; EaglePlayer's own installer makes the Eagleplayer2: assign AmigaMCE uses.
(set #more "")
(if (= (exists "AGS:" (noreq)) 0)
  (if (= (exists "Eagleplayer2:" (noreq)) 0)
    (set #more "\n\nFor module formats beyond ProTracker, XM, S3M and IT (OctaMED, TFMX, Future Composer...), install EaglePlayer from Aminet (mus/play/Eagleplayer) with its own installer.")
  )
)
(exit (cat "AmigaMCE is installed. Double-click it in its drawer to start (on AGS, from Workbench). Without AGS, Settings > Folders says where your music, modules and pictures are." #more))
